# Python environments and caches
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets and local environment files
.env
.env.*
*.env
*.env.*
!.env.example

# Large/generated datasets and local data
data/
gaia_download/
tmp_gaia_samples/

# Local experiment stores and databases
mlruns/
mlflow.db

# Trained model binaries and local artifacts
src/models/*.joblib
src/models/*.pth
src/models/*.pt
src/models/*.bin

# Temporary local outputs
tmp_*.csv
*.err

# Local incident database (created on first API start)
src/api/ai_sre.db
*.db-journal

# Online Boutique is installed from its Helm chart, not vendored here
.official-microservices-demo/

# Terraform: local state, provider cache, logs, and the generated kubeconfig
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.log
infra/terraform/.kube/
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
