# ─── LLM API Keys ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model overrides
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.8-flash

# ─── MCP tool servers ─────────────────────────────────────────────────────────
# Which MCP servers the agent starts; a server that fails to start is skipped.
MCP_SERVERS=kubernetes,github,observability
# GitHub MCP server (read-only). Without it, GitHub tools report "unavailable".
GITHUB_PAT=your_github_fine_grained_token_here
# Observability MCP server
PROMETHEUS_URL=http://localhost:9090

# ─── API security ─────────────────────────────────────────────────────────────
# Shared secret required in the X-API-Key header for every state-changing endpoint
# (analyze, create, approve, reject, execute). Leave empty only for local development.
AI_SRE_API_KEY=generate_a_long_random_string
# Allowed dashboard origins for CORS
DASHBOARD_ORIGINS=http://localhost:3000
# Optional SQLite location (defaults to src/api/ai_sre.db)
AI_SRE_DB_PATH=

# ─── Execution ────────────────────────────────────────────────────────────────
# Auto-execute ACCEPT-classified actions without human approval (keep "false")
AUTO_EXECUTE_ON_ACCEPT=false
EXECUTION_VERIFICATION_TIMEOUT_SECONDS=30

# ─── RAG ──────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── Dashboard (set in dashboard/.env.local, server-side only) ────────────────
# AI_SRE_API_URL=http://127.0.0.1:8000
# AI_SRE_API_KEY=<same value as above>
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=<password for the dashboard login prompt>
